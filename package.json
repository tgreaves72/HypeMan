{
  "name": "hypeman-browser-companion",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "HypeMan, a Y2K browser task companion powered by ChatGPT sign-in.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n gateway,extension \"tsx watch apps/gateway/src/index.ts\" \"node scripts/build.mjs --watch\"",
    "start": "tsx apps/gateway/src/index.ts",
    "build": "node scripts/build.mjs",
    "package:store": "npm run build && node scripts/package-extension.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "art:export": "node scripts/export-y2k-art.mjs",
    "art:skins": "node scripts/export-character-skins.mjs",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-doc-links.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/browser.mjs",
    "e2e:auth": "node tests/chatgpt-browser.mjs",
    "e2e:ui": "node tests/newtab-browser.mjs",
    "e2e:workbench": "node tests/workbench-browser.mjs",
    "e2e:study": "node tests/study-browser.mjs",
    "e2e:hints": "node tests/automatic-hints-browser.mjs",
    "e2e:projects": "node tests/projects-browser.mjs",
    "e2e:messaging": "node tests/messaging-browser.mjs",
    "e2e:reminders": "node tests/reminder-context-browser.mjs",
    "e2e:execution": "node tests/project-execution-browser.mjs",
    "e2e:install": "playwright install chromium",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e:pdf": "node tests/documents-browser.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "openai": "^7.20.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spectrum-ts": "12.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
